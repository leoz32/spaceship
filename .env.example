# Optional: extra exact origins allowed by the personal local proxy.
# Browser Base URL may contain /v1; list only protocol://host:port here.
# SPACESHIP_ALLOWED_ORIGINS=http://127.0.0.1:11434,http://localhost:1234
# For a dedicated DashScope workspace, add its full origin here.
SPACESHIP_ALLOWED_ORIGINS=

# Optional base path when building static files for a subdirectory.
# SPACESHIP_BASE=/spaceship/

# Legacy development scripts only. The application reads keys from its settings.
CEREBRAS_DEV_API_KEY=your_api_key_here
GEMINI_API=your_api_key_here
